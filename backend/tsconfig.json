{
  "compilerOptions": {
    "target": "ES2022" /* Modern JS version */,
    "module": "NodeNext" /* Handles modern module resolution */,
    "moduleResolution": "NodeNext",
    "outDir": "./dist" /* Where compiled JS files will go */,
    "rootDir": "./src" /* Where your TS files live */,
    "strict": true /* Enables all strict type-checking */,
    "esModuleInterop": true /* Emits additional JavaScript to ease imports */,
    "skipLibCheck": true /* Skip type checking of declaration files */,
    "forceConsistentCasingInFileNames": true /* Ensure correct file referencing */
  },
  "include": ["src/**/*"] /* Only compile files inside src */
}
